# ══════════════════════════════════════════════════════════════════════════════
#  scalper-prime — Environment Variables Reference
#
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git — it contains live credentials.
#
#  Every variable listed here is optional unless marked REQUIRED.
#  Variables not set in .env fall back to the defaults in src/config.py.
# ══════════════════════════════════════════════════════════════════════════════


# ── MT5 Account Credentials  [REQUIRED] ───────────────────────────────────────

# Your MT5 login number (integer shown in the MT5 terminal top-left)
TRADING_ID=123456

# Your MT5 account password
MT5_PASSWORD=YourBrokerPassword

# Your broker's MT5 server name (shown in the MT5 login dialog)
# Examples:  HFMarketsKE-Demo2   HFMarketsKE-Live01   ICMarkets-Demo
MT5_SERVER=YourBroker-ServerName


# ── Broker / Account Type  [REQUIRED] ─────────────────────────────────────────
# Controls how spread cost and commission are calculated across the entire bot.
# Must match the account type you logged into above.
#
#   PREMIUM        — HFM Premium:     spread-based (~1.4+ pips GBPUSD), NO commission
#   PRO            — HFM Pro:         spread-based (~0.5+ pips GBPUSD), NO commission
#   ZERO_SPREAD    — HFM Zero Spread: raw spread (~0 pips) + $3/lot commission (majors), $5/lot (Gold)
#   IC_MARKETS_RAW — IC Markets Raw:  ECN spread (~0.1 pips) + $3.50/lot/side commission
#
# To switch to IC Markets:
#   1. Set BROKER_ACCOUNT_TYPE=IC_MARKETS_RAW
#   2. Set MT5_SERVER to your IC Markets server (e.g. ICMarkets-Live01)
#   3. Update TRADING_ID and MT5_PASSWORD with your IC Markets credentials
#   4. Optionally override the commission rate if it changes: IC_COMMISSION_PER_LOT_USD=3.50
BROKER_ACCOUNT_TYPE=PREMIUM

# IC Markets commission override — only needed if IC Markets changes their fee.
# Default: 3.50 (USD per lot per side).
# IC_COMMISSION_PER_LOT_USD=3.50


# ── VNC Access ────────────────────────────────────────────────────────────────
# Browser-based MT5 UI is available at http://localhost:3000 after docker compose up.
# Set a strong password — this port is exposed on your host machine.
VNC_USER=admin
VNC_PASSWORD=change_me_strong_password


# ── News API ──────────────────────────────────────────────────────────────────
# API key for the external forex news feed (ForexFactory/MyFxBook via forex-api container).
# Leave blank to rely on MT5's built-in news feed only.
NEWS_API_KEY=

# URL of the forex-api container. Uses the Docker service name so it resolves
# inside the shared Docker network without needing an IP address.
# Only change this if you are running forex-api on a different host/port.
NEWS_API_URL=http://forex-api:8000


# ── Dashboard Auth ────────────────────────────────────────────────────────────
# Password for the web trading dashboard at http://localhost:8000.
# Leave blank to have a random one-time password printed to the log at startup.
DASHBOARD_PASSWORD=

# JWT token lifetimes (optional — defaults are shown).
# JWT_ACCESS_EXPIRES_MINUTES=15
# JWT_REFRESH_EXPIRES_DAYS=7


# ── Email Alerts ──────────────────────────────────────────────────────────────
# Gmail SMTP credentials for trade alert emails.
# Use an App Password (not your Gmail account password):
#   Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER=youraddress@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_RECIPIENT=recipient@example.com

# SMTP server override — defaults to smtp.gmail.com:587 (optional).
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587


# ── Account Context (optional) ────────────────────────────────────────────────
# Account currency — used for P&L display and position sizing.
# Default: KES (Kenyan Shilling). Change to USD, EUR, etc. as needed.
# ACCOUNT_CURRENCY=KES

# Starting balance used for position sizing on the live account.
# The bot reads live balance from MT5 at runtime; this is only used
# as a fallback when MT5 is unreachable at startup.
# ACCOUNT_BALANCE=30000

# USD → account currency conversion rate (used when ACCOUNT_CURRENCY != USD).
# Default: 130.0 (approximate KES/USD). Update when the rate drifts significantly.
# KES_PER_USD=130.0


# ── Phase 4: Strategy Gate ────────────────────────────────────────────────────
# Controls whether the Phase 1+2+4 strategy engine places real trades.
#
#   false (default) — OBSERVATION MODE
#     The strategy engine evaluates every M1 close and logs STRATEGY_SIGNAL
#     entries to the log, but no trades are placed. The old zone-based
#     execution continues to run as normal. Use this while validating signal
#     quality on a demo account — watch the logs for a few days first.
#
#   true — LIVE MODE
#     Validated signals pass through EntryGate (8 runtime checks) and
#     are executed via ExecutionService. Both the strategy engine AND the
#     old zone-based system run in parallel until the old system is disabled
#     in Phase 6.
#
# ACTIVATION CHECKLIST — do all of these before setting to true:
#   [ ] Observed 50+ STRATEGY_SIGNAL log lines — direction and confidence look reasonable
#   [ ] Session gate fires correctly (only London 06-09 UTC and NY 13-16 UTC)
#   [ ] News gate blocks trading near high-impact events
#   [ ] Running on a DEMO account, not a funded live account
#   [ ] MAX_DAILY_STRATEGY_TRADES set conservatively (start at 3)
STRATEGY_GATE_ENABLED=false

# Maximum number of trades the strategy engine may place per calendar day (UTC).
# Conservative starting value. Raise to 5 after demo performance is confirmed.
MAX_DAILY_STRATEGY_TRADES=3

# Halt strategy trading for the rest of the day if the account equity falls
# this percentage below the equity at the start of the trading session.
# Independent of the overall MAX_OPEN_TRADES cap.
# Example: 1.5 means stop after a -1.5% equity drawdown from session open.
DAILY_DRAWDOWN_LIMIT_PCT=1.5

# Take-profit targets expressed as multiples of the SL distance.
# TP1 = entry ± (SL_distance × TP1_RR_RATIO)  — primary exit (1.5R default)
# TP2 = entry ± (SL_distance × TP2_RR_RATIO)  — runner target (2.5R default)
TP1_RR_RATIO=1.5
TP2_RR_RATIO=2.5


# ── Advanced / Rarely Changed ─────────────────────────────────────────────────
# These have sensible defaults in config.py. Only set them if you need to
# override a specific value without touching config.py.

# Hard cap on lot size — prevents runaway position sizing on any single trade.
# MAX_LOT_SIZE=10.0

# ZMQ endpoint the MT5 EA publishes ticks on. Must match PUB_ENDPOINT in
# ZoneBotBridge.mq5. Only change if you move the EA to a different port.
# ZMQ_ENDPOINT=tcp://127.0.0.1:5556

# Minutes before/after session open to buffer entries (default: 15).
# SESSION_BUFFER_MIN=15
